                }
              }
            }
          ],
          "message": {
            "text": "State variables that are only changed in the constructor should be declared immutable to save gas. Add the `immutable` attribute to state variables that are only changed in the constructor"
          },
          "ruleId": "state-variable-could-be-immutable"
        },
        {
          "level": "note",
