# Engagement secrets — never commit (0600, names-only logging)
engagements/*/.env
*.key
*.pem

# Engagement target repos (fetched reproducibly; URL+commit recorded in engagement.json)
engagements/*/target
engagements/*/repo/
# Real engagements are evidence, not pipeline code — publish each as its own
# audit repo; only the template ships with the pipeline.
engagements/*
!engagements/_template

# Foundry / build outputs inside engagements and template scratch
out/
cache/
build/
engagements/*/artifacts/mutation-workspace/

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store

# quarantined strays — never commit, never delete (deletion policy)
.trash/
